# .env 로 복사해서 사용 (값을 지정하지 않으면 compose.yaml 의 기본값 사용)

# WAF가 요청을 넘길 대상 (Kong 프록시 주소)
WAF_BACKEND=http://kong:8000
# 단독 테스트 시: WAF_BACKEND=http://test-backend:80  (+ docker compose --profile test up -d)

# 포트 바인딩 주소: 내 PC에서만 접속 127.0.0.1 / 다른 PC에서도 접속 0.0.0.0
WAF_BIND=127.0.0.1
WAF_HTTP_PORT=8080
WAF_HTTPS_PORT=8443
WAF_SERVER_NAME=localhost

# CRS 탐지 강도(1~4, 높을수록 오탐 증가) / 차단 기준 점수
WAF_PARANOIA=1
WAF_ANOMALY_INBOUND=5
