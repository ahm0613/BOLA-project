# 이 파일을 .env로 복사해서 값을 채움 (.env는 git에 올리지 않음)
REDIS_PASSWORD=
# 필요하면 config.json 대신 쓸 주소
# REDIS_HOST=192.168.0.39
# REDIS_PORT=6379

# PostgreSQL (docker compose의 postgres 컨테이너, pc1)
# 처음 컨테이너를 만들 때 이 값으로 계정이 생김 (나중에 바꾸려면 볼륨을 지우고 다시 만들거나 ALTER ROLE)
PG_SUPERUSER_PASSWORD=
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=bola_judge
PG_JUDGE_USER=judge
PG_JUDGE_PASSWORD=
# pc3 Streamlit용 읽기 전용 계정
PG_DASHBOARD_USER=dashboard
PG_DASHBOARD_PASSWORD=

# Slack 알림 (notifier.py). 비워 두면 보내지 않고 alerts 테이블에 skipped로만 기록
# 넣은 뒤 docker compose up -d judge 로 컨테이너를 다시 만들어야 반영됨
SLACK_ADMIN_WEBHOOK=
SLACK_DEV_WEBHOOK=
