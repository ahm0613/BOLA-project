# cp .env.example .env 후 값 수정 (.env는 Git에 올리지 말 것)
INDEXER_URL=https://localhost:9200
INDEXER_USER=admin
# 특수문자($ # 등)가 있으면 작은따옴표로 감쌀 것
INDEXER_PASSWORD='SecretPassword'
# false: 인증서 검증 안 함(자체 서명, 개발용) / true / CA 파일 경로 (상대 경로는 이 폴더 기준, 예: ../root-ca.pem)
INDEXER_VERIFY_TLS=false
# (선택) 인증서에 IP가 없을 때 검사할 이름. IP로 접속하면서 CA 검증을 켤 때 사용 (예: wazuh.indexer)
INDEXER_TLS_HOSTNAME=

# smoke_attack.py 대상 (Kong 직접)
KONG_URL=http://localhost:8000
